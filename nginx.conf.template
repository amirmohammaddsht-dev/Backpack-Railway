worker_processes 1;
daemon off;

events {
    worker_connections 1024;
}

http {
    server {
        # گوش دادن روی پورت متغیر Railway
        listen ${PORT};
        
        # 1. هدایت تمام ترافیک اصلی به پنل ثنایی
        location / {
            proxy_pass http://127.0.0.1:2053;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # 2. هدایت مسیر اختصاصی به وب‌یوآی بک‌پک
        location /backpack/ {
            # توجه: اسلش آخر در آدرس آی‌پی برای حذف مسیر /backpack هنگام ارسال به بک‌پک مهم است
            proxy_pass http://127.0.0.1:7777/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            
            # پشتیبانی از وب‌سوکت برای بک‌پک
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }
}